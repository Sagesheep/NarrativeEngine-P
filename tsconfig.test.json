{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "vitest/globals", "node", "@testing-library/jest-dom"],
    // Tests import mods and server modules written in plain JS. Infer their
    // types from the source rather than failing on a missing declaration;
    // the JS itself is not type-checked.
    "allowJs": true,
    "checkJs": false
  },
  // The app project excludes the test folders; this one checks them, along
  // with everything they import.
  "include": ["src/**/__tests__/**/*", "src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**/*"],
  "exclude": []
}
