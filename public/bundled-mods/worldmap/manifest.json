{
    "id": "worldmap",
    "name": "World Map",
    "version": "0.6.0-wip",
    "description": "A pixel-art overworld with free-cell exploration, persistent fog, spaced discoveries, trails and setting-aware encounters. Travel moves one day at a time without routine chat output. See STATUS.md.",
    "tables": [
        {
            "name": "anchors",
            "recordShape": "array",
            "label": "Anchors"
        },
        {
            "name": "settings",
            "recordShape": "single-object",
            "label": "Settings"
        },
        {
            "name": "visited",
            "recordShape": "array",
            "label": "Hardened cells"
        },
        {
            "name": "journey",
            "recordShape": "single-object",
            "label": "Active journey"
        },
        {
            "name": "position",
            "recordShape": "single-object",
            "label": "Party coordinates"
        },
        {
            "name": "trails",
            "recordShape": "single-object",
            "label": "Travelled trails"
        },
        {
            "name": "discoveries",
            "recordShape": "single-object",
            "label": "Discovered sites"
        },
        {
            "name": "encounters",
            "recordShape": "single-object",
            "label": "Checkpoint journal"
        },
        {
            "name": "exploration",
            "recordShape": "single-object",
            "label": "Explored cells"
        },
        {
            "name": "roads",
            "recordShape": "single-object",
            "label": "Roads and paths"
        }
    ],
    "native": {
        "js": "index.js",
        "hooks": {
            "install": "onInstall",
            "activate": "onActivate"
        }
    }
}
