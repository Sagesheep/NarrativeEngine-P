{
    "id":  "ability-compendium",
    "name":  "Ability \u0026 Power Compendium",
    "version":  "2.1.0",
    "appVersion":  "\u003e=1.0.4",
    "description":  "A campaign-neutral library for spells, powers, perks, traits and techniques, including character ownership, runtime state, discovery review, progression, terminology and cross-system references. The prompt block is generated by the native interceptor from this module\u0027s own tables.",
    "tables":  [
                   {
                       "name":  "abilities",
                       "recordShape":  "array",
                       "label":  "Canonical Abilities"
                   },
                   {
                       "name":  "assignments",
                       "recordShape":  "array",
                       "label":  "Character Abilities"
                   },
                   {
                       "name":  "runtime",
                       "recordShape":  "array",
                       "label":  "Runtime State"
                   },
                   {
                       "name":  "proposals",
                       "recordShape":  "array",
                       "label":  "Discovery Proposals"
                   },
                   {
                       "name":  "config",
                       "recordShape":  "single-object",
                       "label":  "Compendium Configuration"
                   },
                   {
                       "name":  "prompt-index",
                       "recordShape":  "array",
                       "label":  "Prompt Lookup Index"
                   }
               ],
    "compute":  {
                    "file":  "ability-compendium.compute.js",
                    "hook":  "postTurn",
                    "capabilities":  [
                                         "table:read:mod.ability-compendium.abilities",
                                         "table:read:mod.ability-compendium.assignments",
                                         "table:read:mod.ability-compendium.runtime",
                                         "table:read:mod.ability-compendium.proposals",
                                         "table:read:mod.ability-compendium.config",
                                         "table:write:mod.ability-compendium.proposals",
                                         "table:write:mod.ability-compendium.config",
                                         "table:write:mod.ability-compendium.prompt-index",
                                         "model:utility"
                                     ]
                },
    "screens":  [
                    {
                        "id":  "manager",
                        "file":  "ability-compendium.screen.js",
                        "label":  "Open Ability \u0026 Power Compendium"
                    }
                ],
    "apiVersion":  1,
    "native":  {
                   "js":  "ability-compendium.native.js",
                   "hooks":  {
                                 "activate":  "onActivate",
                                 "disable":  "onDisable"
                             },
                   "generateInterceptor":  "interceptPrompt"
               }
}
